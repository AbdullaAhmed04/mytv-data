{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AbdullaAhmed04/mytv-data/main/schemas/versions.schema.json",
  "title": "MYTV approved versions",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "channelsVersion", "linksVersion", "appConfigVersion", "publishedAt", "publishedBy", "approvedCommit", "repository", "branch"],
  "properties": {
    "schemaVersion": {"const": 1},
    "channelsVersion": {"type": "integer", "minimum": 1},
    "linksVersion": {"type": "integer", "minimum": 1},
    "appConfigVersion": {"type": "integer", "minimum": 1},
    "publishedAt": {"type": "string", "format": "date-time"},
    "publishedBy": {"type": "string", "minLength": 1},
    "approvedCommit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
    "repository": {"type": "string", "const": "https://github.com/AbdullaAhmed04/mytv-data"},
    "branch": {"type": "string", "const": "main"}
  }
}
