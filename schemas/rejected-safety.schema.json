{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AbdullaAhmed04/mytv-data/main/schemas/rejected-safety.schema.json",
  "title": "MYTV safety rejection summary",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "items"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "adultRejectedCount": {"type": "integer", "minimum": 0},
    "count": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["channelId", "reason"], "properties": {"channelId": {"type": "string"}, "reason": {"type": "string"}}}}
  },
  "additionalProperties": false
}
