{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AbdullaAhmed04/mytv-data/main/schemas/app-config.schema.json",
  "title": "MYTV Android endpoint bootstrap",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "version", "endpoints"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "integer", "minimum": 1},
    "endpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["channels", "links", "versions"],
      "properties": {
        "channels": {"type": "string", "format": "uri", "pattern": "^https://"},
        "links": {"type": "string", "format": "uri", "pattern": "^https://"},
        "versions": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    }
  }
}
